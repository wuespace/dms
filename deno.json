{
  "tasks": {
    "dev": "DEVELOPMENT=true deno run --env-file=.env --watch -A main.ts",
    "start": "deno run -A main.ts",
    "compile:theme": "deno run --allow-env --allow-read --allow-write scripts/compile-theme.ts",
    "compile:client": "deno run -A scripts/compile-client.ts",
    "env:all": "deno task env:example && deno task env:docs",
    "env:example": "deno run --allow-read --allow-write jsr:@wuespace/envardoc@0.4.1 example -r example.env",
    "env:docs": "deno run --allow-read --allow-write jsr:@wuespace/envardoc@0.4.1 docs -o env.md example.env",
    "update:i18n": "deno run --allow-env --allow-read --allow-write=./locales/ i18n.ts",
    "check:i18n": "deno run --allow-env --allow-read --allow-write=./locales/ i18n.ts --read-only"
  },
  "imports": {
    "@db/mongo": "https://deno.land/x/mongo@v0.32.0/mod.ts",
    "@hexagon/croner": "jsr:@hexagon/croner@^9.1.0",
    "@hono/hono": "jsr:@hono/hono@^4.10.4",
    "@hono/oidc-auth": "npm:@hono/oidc-auth@^1.7.1",
    "@hono/sentry": "npm:@hono/sentry@^1.2.2",
    "@loglayer/transport-simple-pretty-terminal": "npm:@loglayer/transport-simple-pretty-terminal@^2.2.14",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.10.3",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.10",
    "@wuespace/envar": "jsr:@wuespace/envar@^1.1.1",
    "@wuespace/honolate": "jsr:@wuespace/honolate@^0.2.0",
    "@yaireo/tagify": "npm:@yaireo/tagify@^4.35.5",
    "@zod/zod": "jsr:@zod/zod@^4.1.12",
    "filepond": "npm:filepond@^4.32.10",
    "loglayer": "npm:loglayer@^8.1.0",
    "sass": "npm:sass@^1.93.3",
    "serialize-error": "npm:serialize-error@^12.0.0"
  },
  "fmt": {
    "semiColons": false
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@hono/hono/jsx"
  },
  "lint": {
    "include": [
      "client/**/*",
      "server/**/*",
      "main.ts",
      "scripts/**/*",
      "deno.json",
      "tsconfig.json"
    ],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  }
}
